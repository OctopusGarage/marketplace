{
  "name": "@octopusgarage/marketplace",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:studio": "vite build --config vite.config.ts",
    "test:studio": "npm run build:studio && playwright test",
    "test:pack": "node --test scripts/pack.test.mjs",
    "eval:pack-tools": "node evals/run.mjs",
    "pack:build": "node --experimental-strip-types scripts/pack.mjs build",
    "pack:check": "node --experimental-strip-types scripts/pack.mjs check",
    "check:catalog": "node --experimental-strip-types scripts/check-catalog.mjs",
    "check:immutability": "node --test scripts/check-immutability.test.mjs && node scripts/check-immutability.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "fflate": "0.8.3" },
  "devDependencies": { "@playwright/test": "1.63.0", "@types/node": "^26.6.4", "typescript": "^5.6.3", "vite": "^8.3.2" }
}
